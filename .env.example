# ==============================================================================
# LectureScribe AI — Environment Variables Template
# Copy this file to .env.local (or add to Vercel Environment Variables)
# ==============================================================================

# 1. Groq API Key (Required for Whisper Large V3 Turbo transcription & Llama 3.3 70B analysis/tutor)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# 2. Supabase Cloud Sync & Google OAuth (Required for Google Sign-In & Cloud Notes Sync)
# Create a project at: https://supabase.com/dashboard
# Enable Google Provider in Authentication -> Providers -> Google
# Add Redirect URL: https://lecturescribe-three.vercel.app/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Google One Tap Sign-In (Optional — used by AuthModal for Google GIS One Tap)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
