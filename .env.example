# ==============================================================================
# LectureScribe AI — Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# The app includes automatic local/guest fallbacks if keys are left unset.
# ==============================================================================

# 1. Groq API Key (Required for Whisper Large V3 Turbo transcription & Qwen 3.8 analysis/tutor)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Supabase Cloud Sync & Auth (Optional — falls back to Local Storage Guest Mode if omitted)
# Create a project at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Google One Tap Sign-In (Optional — used by AuthModal for Google GIS login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
